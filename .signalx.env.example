# REQUIRED
SIGNALX_SIGNALCLI_CONFIG=/Users/you/.local/share/signal-cli
SIGNALX_NUMBER=+1XXXXXXXXXX

# OPTIONAL (recommended)
SIGNALX_SIGNALCLI_BIN=/opt/homebrew/bin/signal-cli

# OPTIONAL (AI tools — local Ollama HTTP API)
# ollama serve
# SIGNALX_OLLAMA_MODEL=qwen2.5:3b-instruct
# SIGNALX_OLLAMA_URL=http://localhost:11434
# SIGNALX_OLLAMA_TIMEOUT_SECS=120
